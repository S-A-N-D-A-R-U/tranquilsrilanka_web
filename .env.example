# ─────────────────────────────────────────────────────────────────────────────
# Tranquil Sri Lanka — public website
#
# Copy to .env.local for local development:   cp .env.example .env.local
# On Vercel: Project → Settings → Environment Variables (Production + Preview),
# then redeploy — new values only apply to the next deployment.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# MongoDB connection string — the same database the admin panel writes to.
# Required at build time too: `next build` pre-renders tour/activity/blog pages.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority

# ── Email for the contact / plan-a-trip / transfer / booking forms (required) ─
# Sent through Gmail. MAIL_PASS must be a Gmail *App Password*
# (Google Account → Security → 2-Step Verification → App passwords),
# not your normal Gmail password.
# EMAIL_USER / EMAIL_PASS are accepted as alternative names and take priority
# if set. Use one pair only — check which one Vercel has before removing either.
MAIL_USER=tranquilsrilanka@gmail.com
MAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Where form submissions are delivered (optional).
# Falls back to MAIL_FROM, then to MAIL_USER.
CONTACT_EMAIL=tranquilsrilanka@gmail.com
# MAIL_FROM=

# ── Cache refresh from the admin panel (recommended) ─────────────────────────
# A password you make up. Enables POST /api/revalidate so admin edits appear
# on the site immediately instead of within an hour.
# Must match SITE_REVALIDATE_SECRET in the admin panel.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# ── Set automatically — do not add ───────────────────────────────────────────
# NODE_ENV     set by Next.js
# VERCEL_ENV   set by Vercel (enables the Vercel toolbar in the CSP on previews)

# ── No longer used — safe to delete from .env.local / Vercel ─────────────────
# MAIL_HOST, MAIL_PORT            (mailer uses Gmail's built-in settings)
